.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 0 0 50rpx;
    background: #f4f6fa;
}

/* ---------- 头部 ---------- */
.header {
    padding: 24rpx 32rpx 28rpx;
    background: #ffffff;
}

.header-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
}

.header-title {
    color: #1a1f36;
    font-size: 38rpx;
    font-weight: 700;
}

.header-rule {
    color: #a8b0c2;
    font-size: 19rpx;
}

.header-sub {
    display: block;
    margin-top: 10rpx;
    color: #8d97ad;
    font-size: 22rpx;
}

/* ---------- 全部错题卡 ---------- */
.all-card {
    display: flex;
    margin: 20rpx 24rpx 0;
    padding: 26rpx 28rpx;
    align-items: center;
    border-radius: 20rpx;
    background: linear-gradient(135deg, #eef2ff, #f7f9ff);
    justify-content: space-between;
}

.all-left {
    display: flex;
    align-items: baseline;
}

.all-title {
    color: #1a1f36;
    font-size: 29rpx;
    font-weight: 600;
}

.all-count {
    margin-left: 12rpx;
    color: #7a839a;
    font-size: 22rpx;
}

.all-actions {
    display: flex;
}

/* ---------- 按钮 ---------- */
.mini-btn {
    padding: 10rpx 22rpx;
    border-radius: 999rpx;
    background: #2b4acb;
}

.mini-btn-text {
    color: #ffffff;
    font-size: 22rpx;
}

.mini-btn-ghost {
    margin-right: 12rpx;
    background: #ffffff;
    border: 2rpx solid #dde3f0;
}

.mini-btn-ghost-text {
    color: #5c6478;
    font-size: 22rpx;
}

/* ---------- 分组 ---------- */
.group-list {
    margin: 16rpx 24rpx 0;
    overflow: hidden;
    border-radius: 20rpx;
    background: #ffffff;
}

.group {
    border-bottom: 2rpx solid #f4f6fa;
}

.group:last-child {
    border-bottom: none;
}

.group-row {
    display: flex;
    padding: 24rpx 26rpx;
    align-items: center;
    justify-content: space-between;
}

.group-main {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
}

.group-name {
    color: #1a1f36;
    font-size: 27rpx;
    line-height: 1.45;
}

.group-meta {
    display: flex;
    margin-top: 8rpx;
    align-items: center;
}

.group-chip {
    padding: 1rpx 8rpx;
    border-radius: 4rpx;
    background: #eef2ff;
    color: #2b4acb;
    font-size: 17rpx;
}

.group-count {
    margin-left: 10rpx;
    color: #a8b0c2;
    font-size: 20rpx;
}

.group-actions {
    display: flex;
    margin-left: 14rpx;
    flex-shrink: 0;
    align-items: center;
}

/* ---------- 展开详情 ---------- */
.detail {
    padding: 0 26rpx 10rpx;
    background: #fafbfe;
}

.detail-item {
    padding: 22rpx 0;
    border-top: 2rpx solid #eef1f7;
}

.detail-stem {
    margin-bottom: 14rpx;
}

.detail-options {
    margin-bottom: 10rpx;
}

.detail-option {
    display: flex;
    margin-bottom: 8rpx;
    padding: 10rpx 14rpx;
    align-items: flex-start;
    border-radius: 10rpx;
    background: #ffffff;
}

.detail-option-ans {
    background: #f2fbf7;
}

.detail-option-letter {
    display: flex;
    width: 32rpx;
    height: 32rpx;
    flex-shrink: 0;
    align-items: center;
    border-radius: 50%;
    background: #eef1f7;
    color: #6b7488;
    font-size: 18rpx;
    font-weight: 600;
    justify-content: center;
}

.detail-option-letter-ans {
    background: #1aa06d;
    color: #ffffff;
}

.detail-option-text {
    margin-left: 12rpx;
    color: #3d4762;
    font-size: 24rpx;
    line-height: 1.55;
}

.detail-analysis {
    display: block;
    margin-top: 8rpx;
    color: #4a5268;
    font-size: 24rpx;
    line-height: 1.8;
}

.detail-foot {
    display: flex;
    margin-top: 14rpx;
    align-items: center;
    justify-content: space-between;
}

.detail-times {
    color: #c97d1e;
    font-size: 20rpx;
}

.detail-remove {
    color: #b9c0d1;
    font-size: 21rpx;
}

/* ---------- 底部 ---------- */
.foot-actions {
    margin-top: 26rpx;
    text-align: center;
}

.foot-clear {
    color: #b9c0d1;
    font-size: 23rpx;
}

/* ---------- 状态 ---------- */
.state-card {
    display: flex;
    margin: 24rpx;
    padding: 80rpx 44rpx;
    align-items: center;
    border-radius: 20rpx;
    background: #ffffff;
    flex-direction: column;
    text-align: center;
}

.state-title {
    margin-top: 16rpx;
    color: #1a1f36;
    font-size: 29rpx;
    font-weight: 600;
}

.state-desc {
    margin-top: 12rpx;
    color: #8d97ad;
    font-size: 23rpx;
    line-height: 1.7;
}

.state-btn {
    margin-top: 30rpx;
    padding: 0 56rpx;
    background: #2b4acb;
    color: #ffffff;
    font-size: 26rpx;
    line-height: 76rpx;
}

.empty-mark {
    display: flex;
    width: 100rpx;
    height: 100rpx;
    align-items: center;
    border-radius: 50%;
    background: #f2fbf7;
    justify-content: center;
}

.empty-mark-text {
    color: #1aa06d;
    font-size: 48rpx;
    font-weight: 700;
}

.spinner {
    width: 40rpx;
    height: 40rpx;
    margin-bottom: 18rpx;
    border: 6rpx solid #e6ebf7;
    border-top-color: #2b4acb;
    border-radius: 50%;
}
