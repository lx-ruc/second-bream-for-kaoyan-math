.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 0 0 50rpx;
    background: #f4f6fa;
}

/* ---------- 顶栏 ---------- */
.navbar {
    background: #ffffff;
}

.navbar-row {
    display: flex;
    height: 88rpx;
    padding: 0 24rpx;
    align-items: center;
    justify-content: space-between;
}

.navbar-back {
    display: flex;
    width: 64rpx;
    align-items: center;
}

.navbar-back-icon {
    color: #1a1f36;
    font-size: 46rpx;
    font-weight: 300;
    line-height: 1;
}

.navbar-title {
    color: #1a1f36;
    font-size: 30rpx;
    font-weight: 600;
}

.navbar-placeholder {
    width: 64rpx;
}

/* ---------- 说明 ---------- */
.intro {
    padding: 22rpx 32rpx 0;
    background: #ffffff;
    padding-bottom: 26rpx;
}

.intro-text {
    color: #8d97ad;
    font-size: 22rpx;
    line-height: 1.7;
}

/* ---------- 空态引导 ---------- */
.empty-card {
    display: flex;
    margin: 20rpx 24rpx 0;
    padding: 56rpx 32rpx 40rpx;
    align-items: center;
    border-radius: 22rpx;
    background: #ffffff;
    flex-direction: column;
}

.empty-icon {
    display: flex;
    width: 128rpx;
    height: 128rpx;
    align-items: center;
    border: 2rpx dashed #c8d3ef;
    border-radius: 24rpx;
    background: #f7f9ff;
    justify-content: center;
}

.empty-icon-text {
    color: #7d94e0;
    font-size: 56rpx;
}

.empty-title {
    margin-top: 24rpx;
    color: #1a1f36;
    font-size: 30rpx;
    font-weight: 600;
}

.empty-desc {
    margin-top: 10rpx;
    color: #a8b0c2;
    font-size: 22rpx;
}

.empty-actions {
    width: 100%;
    margin-top: 32rpx;
}

.btn-main {
    height: 88rpx;
    border-radius: 16rpx;
    background: #2b4acb;
    color: #ffffff;
    font-size: 29rpx;
    font-weight: 600;
    line-height: 88rpx;
}

.empty-tips {
    display: flex;
    margin-top: 26rpx;
    flex-direction: column;
}

.empty-tip {
    margin-top: 6rpx;
    color: #b9c0d1;
    font-size: 20rpx;
    line-height: 1.6;
}

/* ---------- 预览 ---------- */
.preview-card {
    margin: 20rpx 24rpx 0;
    padding: 24rpx;
    border-radius: 22rpx;
    background: #ffffff;
}

.preview-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.preview-title {
    color: #1a1f36;
    font-size: 26rpx;
    font-weight: 600;
}

.preview-size {
    padding: 3rpx 12rpx;
    border-radius: 6rpx;
    background: #f4f6fa;
}

.preview-size-text {
    color: #98a1b5;
    font-family: "DIN Alternate", sans-serif;
    font-size: 19rpx;
}

.canvas-box {
    position: relative;
    margin: 18rpx auto 0;
    overflow: hidden;
    border-radius: 12rpx;
    background: #f0f2f7;
}

.scan-canvas {
    display: block;
}

.busy-mask {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    background: rgba(26, 31, 54, 0.45);
    flex-direction: column;
    justify-content: center;
}

.busy-spinner {
    width: 40rpx;
    height: 40rpx;
    border: 5rpx solid rgba(255, 255, 255, 0.35);
    border-top-color: #ffffff;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
}

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}

.busy-text {
    margin-top: 14rpx;
    color: #ffffff;
    font-size: 21rpx;
}

/* ---------- 模式切换 ---------- */
.mode-row {
    display: flex;
    margin-top: 20rpx;
    padding: 6rpx;
    border-radius: 999rpx;
    background: #f4f6fa;
}

.mode-item {
    display: flex;
    flex: 1;
    padding: 14rpx 0;
    align-items: center;
    border-radius: 999rpx;
    justify-content: center;
}

.mode-item-on {
    background: #ffffff;
    box-shadow: 0 2rpx 8rpx rgba(26, 31, 54, 0.08);
}

.mode-text {
    color: #8d97ad;
    font-size: 24rpx;
}

.mode-item-on .mode-text {
    color: #2b4acb;
    font-weight: 600;
}

/* ---------- 预览操作 ---------- */
.preview-actions {
    display: flex;
    margin-top: 20rpx;
    align-items: center;
}

.btn-ghost {
    display: flex;
    height: 80rpx;
    padding: 0 30rpx;
    align-items: center;
    border-radius: 14rpx;
    background: #f4f6fa;
    justify-content: center;
}

.btn-ghost-text {
    color: #5c6478;
    font-size: 25rpx;
}

.btn-save {
    display: flex;
    flex: 1;
    height: 80rpx;
    margin-left: 14rpx;
    align-items: center;
    border-radius: 14rpx;
    background: #2b4acb;
    justify-content: center;
}

.btn-save-disabled {
    background: #b9c4e8;
}

.btn-save-text {
    color: #ffffff;
    font-size: 27rpx;
    font-weight: 600;
}

/* ---------- 列表 ---------- */
.list-head {
    display: flex;
    margin: 32rpx 32rpx 14rpx;
    align-items: baseline;
    justify-content: space-between;
}

.list-title {
    color: #1a1f36;
    font-size: 27rpx;
    font-weight: 600;
}

.list-count {
    color: #a8b0c2;
    font-size: 21rpx;
}

.scan-grid {
    display: flex;
    margin: 0 24rpx;
    flex-wrap: wrap;
}

.scan-item {
    width: 333rpx;
    margin-bottom: 22rpx;
    margin-right: 20rpx;
    padding: 14rpx;
    border-radius: 18rpx;
    background: #ffffff;
}

.scan-item:nth-child(2n) {
    margin-right: 0;
}

.scan-thumb-box {
    position: relative;
    width: 100%;
    height: 380rpx;
    overflow: hidden;
    border-radius: 12rpx;
    background: #f0f2f7;
}

.scan-thumb {
    width: 100%;
    height: 100%;
}

.scan-mode-tag {
    position: absolute;
    right: 8rpx;
    bottom: 8rpx;
    padding: 2rpx 10rpx;
    border-radius: 6rpx;
    background: rgba(26, 31, 54, 0.6);
}

.scan-mode-text {
    color: #ffffff;
    font-size: 17rpx;
}

.scan-time {
    display: block;
    margin-top: 12rpx;
    color: #8d97ad;
    font-size: 20rpx;
}

.scan-delete {
    display: block;
    margin-top: 4rpx;
    color: #c8cedd;
    font-size: 20rpx;
}

.list-empty {
    margin: 0 24rpx;
    padding: 60rpx 0;
    border-radius: 20rpx;
    background: #ffffff;
    text-align: center;
}

.list-empty-text {
    color: #b9c0d1;
    font-size: 22rpx;
}

/* ---------- 大图 ---------- */
.viewer {
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    background: rgba(12, 16, 28, 0.94);
    flex-direction: column;
    justify-content: center;
}

.viewer-img {
    width: 100%;
    height: 78vh;
}

.viewer-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    padding: 24rpx 40rpx calc(34rpx + env(safe-area-inset-bottom));
    align-items: center;
    justify-content: space-between;
}

.viewer-close {
    color: rgba(255, 255, 255, 0.8);
    font-size: 26rpx;
}

.viewer-delete {
    color: #ff8f8f;
    font-size: 26rpx;
}
