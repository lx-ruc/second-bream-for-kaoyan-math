.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 0 0 50rpx;
    background: #f4f6fa;
}

/* ---------- 用户区 ---------- */
.hero {
    padding: 24rpx 32rpx 28rpx;
    background: #ffffff;
}

.user-row {
    display: flex;
    align-items: center;
}

.avatar {
    display: flex;
    width: 96rpx;
    height: 96rpx;
    align-items: center;
    border-radius: 28rpx;
    background: #eef2ff;
    justify-content: center;
}

.avatar-text {
    color: #2b4acb;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 54rpx;
    font-style: italic;
    line-height: 1;
    padding-bottom: 6rpx;
}

.user-info {
    display: flex;
    margin-left: 20rpx;
    flex-direction: column;
}

.user-name {
    color: #1a1f36;
    font-size: 32rpx;
    font-weight: 600;
}

.user-desc {
    margin-top: 8rpx;
    color: #8d97ad;
    font-size: 21rpx;
}

.stat-row {
    display: flex;
    margin-top: 28rpx;
    padding-top: 24rpx;
    align-items: center;
    border-top: 2rpx solid #f4f6fa;
}

.stat {
    display: flex;
    flex: 1;
    align-items: center;
    flex-direction: column;
}

.stat-value {
    color: #1a1f36;
    font-family: "DIN Alternate", sans-serif;
    font-size: 36rpx;
    font-weight: 700;
    line-height: 1.15;
}

.stat-label {
    margin-top: 8rpx;
    color: #98a1b5;
    font-size: 20rpx;
}

.stat-line {
    width: 2rpx;
    height: 40rpx;
    background: #f4f6fa;
}

/* ---------- 得分段位 ---------- */
.score-card {
    margin: 16rpx 24rpx 0;
    padding: 26rpx;
    border-radius: 20rpx;
    background: #ffffff;
}

.score-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
}

.score-left {
    display: flex;
    flex-direction: column;
}

.score-label {
    color: #8d97ad;
    font-size: 21rpx;
}

.score-value-row {
    display: flex;
    margin-top: 6rpx;
    align-items: baseline;
}

.score-value {
    color: #2b4acb;
    font-family: "DIN Alternate", sans-serif;
    font-size: 52rpx;
    font-weight: 700;
    line-height: 1;
}

.score-unit {
    margin-left: 6rpx;
    color: #8d97ad;
    font-size: 21rpx;
}

.score-right {
    display: flex;
    align-items: flex-end;
    flex-direction: column;
}

.rank-chip {
    padding: 4rpx 18rpx;
    border-radius: 999rpx;
    background: #fff6ea;
}

.rank-chip-text {
    color: #c97d1e;
    font-size: 21rpx;
    font-weight: 600;
}

.score-today {
    margin-top: 10rpx;
    color: #1aa06d;
    font-size: 20rpx;
}

.score-today-minus {
    color: #e05555;
}

.rank-bar {
    height: 10rpx;
    margin-top: 18rpx;
    overflow: hidden;
    border-radius: 999rpx;
    background: #f0f2f7;
}

.rank-fill {
    height: 100%;
    border-radius: 999rpx;
    background: linear-gradient(90deg, #f0a92c, #f7c948);
}

.rank-foot {
    display: flex;
    margin-top: 12rpx;
    align-items: center;
    justify-content: space-between;
}

.rank-desc {
    color: #a8b0c2;
    font-size: 20rpx;
}

.rank-next {
    color: #c97d1e;
    font-size: 20rpx;
}

/* ---------- 今日 ---------- */
.today-card {
    margin: 16rpx 24rpx 0;
    padding: 24rpx 26rpx;
    border-radius: 20rpx;
    background: #ffffff;
}

.today-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.today-title {
    color: #1a1f36;
    font-size: 26rpx;
    font-weight: 600;
}

.today-num {
    color: #2b4acb;
    font-family: "DIN Alternate", sans-serif;
    font-size: 23rpx;
}

.today-bar {
    height: 10rpx;
    margin-top: 16rpx;
    overflow: hidden;
    border-radius: 999rpx;
    background: #f0f2f7;
}

.today-fill {
    height: 100%;
    border-radius: 999rpx;
    background: linear-gradient(90deg, #2b4acb, #6a8bff);
}

/* ---------- 能力图谱 ---------- */
.radar-card {
    margin: 16rpx 24rpx 0;
    padding: 24rpx 0 22rpx;
    border-radius: 20rpx;
    background: #ffffff;
}

.radar-head {
    display: flex;
    padding: 0 26rpx;
    align-items: baseline;
    justify-content: space-between;
}

.radar-title {
    color: #1a1f36;
    font-size: 26rpx;
    font-weight: 600;
}

.radar-sub {
    color: #a8b0c2;
    font-size: 20rpx;
}

.radar-rule {
    padding: 4rpx 16rpx;
    border-radius: 999rpx;
    background: #f4f6fa;
}

.radar-rule-text {
    color: #6b7488;
    font-size: 19rpx;
}

.radar-wrap {
    position: relative;
    width: 420rpx;
    height: 420rpx;
    margin: 8rpx auto 0;
}

.radar-canvas {
    position: absolute;
    left: 0;
    top: 0;
    width: 420rpx;
    height: 420rpx;
}

.radar-label {
    position: absolute;
    display: flex;
    align-items: center;
    flex-direction: column;
    transform: translate(-50%, -50%);
    white-space: nowrap;
}

.radar-label-name {
    color: #5c6478;
    font-size: 20rpx;
    line-height: 1.3;
}

.radar-label-value {
    color: #2b4acb;
    font-family: "DIN Alternate", sans-serif;
    font-size: 22rpx;
    font-weight: 700;
    line-height: 1.3;
}

.radar-label-empty {
    color: #c0c6d4;
    font-weight: 500;
}

/* 退化条形 */
.radar-fallback {
    padding: 16rpx 26rpx 4rpx;
}

.fb-row {
    display: flex;
    margin-bottom: 14rpx;
    align-items: center;
}

.fb-name {
    width: 150rpx;
    color: #5c6478;
    font-size: 21rpx;
}

.fb-track {
    flex: 1;
    height: 12rpx;
    overflow: hidden;
    border-radius: 999rpx;
    background: #f0f2f7;
}

.fb-fill {
    height: 100%;
    border-radius: 999rpx;
    background: linear-gradient(90deg, #2b4acb, #6a8bff);
}

.fb-value {
    width: 54rpx;
    color: #2b4acb;
    font-family: "DIN Alternate", sans-serif;
    font-size: 22rpx;
    text-align: right;
}

.radar-foot {
    padding: 0 26rpx;
    margin-top: 16rpx;
}

.radar-tip {
    display: block;
    color: #b0b7c6;
    font-size: 19rpx;
    line-height: 1.6;
}

.radar-tags {
    display: flex;
    margin-top: 12rpx;
    flex-wrap: wrap;
}

.radar-tag {
    margin-right: 12rpx;
    padding: 4rpx 14rpx;
    border-radius: 6rpx;
    background: #f2fbf7;
    color: #1aa06d;
    font-size: 19rpx;
}

.radar-tag-weak {
    background: #fff6ea;
    color: #c97d1e;
}

/* ---------- 周图 ---------- */
.week-card {
    margin: 16rpx 24rpx 0;
    padding: 24rpx 26rpx 20rpx;
    border-radius: 20rpx;
    background: #ffffff;
}

.week-title {
    color: #1a1f36;
    font-size: 26rpx;
    font-weight: 600;
}

.chart {
    display: flex;
    height: 220rpx;
    margin-top: 18rpx;
    align-items: flex-end;
}

.chart-col {
    display: flex;
    flex: 1;
    height: 100%;
    align-items: center;
    flex-direction: column;
    justify-content: flex-end;
}

.chart-wrap {
    display: flex;
    width: 100%;
    height: 140rpx;
    align-items: flex-end;
    justify-content: center;
}

.chart-bar {
    width: 24rpx;
    min-height: 6rpx;
    border-radius: 8rpx 8rpx 3rpx 3rpx;
    background: #eef1f7;
    transition: height 0.3s ease;
}

.chart-bar-on {
    background: linear-gradient(180deg, #7b96ff, #2b4acb);
}

.chart-value {
    margin-top: 10rpx;
    color: #6b7488;
    font-family: "DIN Alternate", sans-serif;
    font-size: 19rpx;
}

.chart-label {
    margin-top: 4rpx;
    color: #b9c0d1;
    font-size: 19rpx;
}

/* ---------- 菜单 ---------- */
.menu {
    margin: 16rpx 24rpx 0;
    overflow: hidden;
    border-radius: 20rpx;
    background: #ffffff;
}

.menu-item {
    display: flex;
    padding: 28rpx 26rpx;
    align-items: center;
    border-bottom: 2rpx solid #f6f8fb;
    justify-content: space-between;
}

.menu-item:last-child {
    border-bottom: none;
}

.menu-hover {
    background: #f8faff;
}

.menu-text {
    color: #1a1f36;
    font-size: 27rpx;
}

.menu-right {
    display: flex;
    align-items: center;
}

.menu-desc {
    color: #a8b0c2;
    font-size: 22rpx;
}

.menu-arrow {
    margin-left: 8rpx;
    color: #ccd2df;
    font-size: 30rpx;
    line-height: 1;
}

/* ---------- 底部 ---------- */
.foot {
    margin-top: 32rpx;
    text-align: center;
}

.foot-text {
    color: #b9c0d1;
    font-size: 20rpx;
}
