page {
    min-height: 100%;
    background: #f2f4f9;
    color: #1a1f36;
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
    -webkit-font-smoothing: antialiased;
}

view,
text,
button {
    box-sizing: border-box;
}

button {
    border-radius: 16rpx;
    font-weight: 500;
}

button::after {
    border: none;
}

/* ---------- 通用卡片 ---------- */
.card {
    padding: 32rpx;
    border-radius: 28rpx;
    background: #ffffff;
    box-shadow: 0 4rpx 20rpx rgba(26, 31, 54, 0.04);
}

.section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20rpx;
}

.section-title {
    font-size: 32rpx;
    font-weight: 600;
    letter-spacing: 0.5rpx;
}

.section-more {
    color: #8d97ad;
    font-size: 24rpx;
}
