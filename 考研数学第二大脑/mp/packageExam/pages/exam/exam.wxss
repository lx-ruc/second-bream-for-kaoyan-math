/* 真题详情页（分包）。基础卡片/按钮/标题类继承 app.wxss，这里只放本页私有样式。 */

.stem,
.ans,
.sol {
  display: block;
  font-size: 29rpx;
  line-height: 1.78;
  color: #211f1c;
  word-break: break-all;
}

.ans {
  font-weight: 600;
  color: #2f6b52;
}

.sol {
  color: #38342d;
}

.d-t {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  margin: 6rpx 0 14rpx;
}

.fam {
  display: flex;
  margin-bottom: 14rpx;
}

.fam-n {
  width: 44rpx;
  flex: none;
  font-family: Georgia, serif;
  font-size: 26rpx;
  color: #a6342a;
  padding-top: 2rpx;
}

.fam-t {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.6;
  color: #38342d;
}

.empty {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #9c9587;
  font-size: 26rpx;
  line-height: 1.8;
}

.empty text {
  display: block;
}
