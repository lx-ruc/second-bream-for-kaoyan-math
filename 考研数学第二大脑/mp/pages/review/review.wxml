<view class="page">
  <view class="head">
    <text class="kicker">第二大脑 · 间隔复习</text>
    <text class="h1">{{today}}，该复习什么</text>
    <text class="lede">错因聚类 → 章节 → 难度排序；「思路缺失 / 概念不清」优先。题评卡不占复习位。</text>
  </view>

  <view class="card">
    <text class="sec">今日到期 {{total}} 条</text>
    <text class="r-sum">合计建议 {{minutes}} 分钟。</text>
    <text class="note">{{tip}}：难度 1/2/3/4/5 对应 3/5/8/12/15 分钟，这是产品估算，不是实测数据。</text>
    <text class="note">间隔 1/3/7/15/30/60 天：答对升级，答错归零并安排在今天再来。</text>
  </view>

  <view wx:if="{{empty}}" class="empty">今天没有到期条目。可以去记一张新卡，或下次再来。</view>

  <view wx:for="{{rows}}" wx:key="id" class="card tight r-row">
    <view class="r-head">
      <text class="r-title">{{item.title}}</text>
      <text wx:if="{{item.incomplete}}" class="chip hot">未完成</text>
    </view>
    <text class="r-meta">{{item.groupText}} · {{item.tagsText}} · {{item.dueText}} · Lv{{item.level}}</text>
    <text class="r-min">建议 {{item.minutes}} 分钟</text>
    <view class="r-acts">
      <view class="r-btn ok" data-id="{{item.id}}" data-ok="yes" bindtap="onDone">答对</view>
      <view class="r-btn again" data-id="{{item.id}}" data-ok="no" bindtap="onDone">答错</view>
      <view class="r-btn detail" data-id="{{item.id}}" bindtap="onOpen">查看</view>
    </view>
  </view>

  <view class="btn ghost" bindtap="goNew">记一张新卡</view>
</view>
