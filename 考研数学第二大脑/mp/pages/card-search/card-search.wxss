.fld {
  margin-bottom: 24rpx;
}

.fld-label {
  display: block;
  font-size: 23rpx;
  color: #6b6558;
  margin-bottom: 10rpx;
}

.fld-input {
  width: 100%;
  box-sizing: border-box;
  background: #f4f1ea;
  border: 1rpx solid #e6dfd1;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 27rpx;
  color: #211f1c;
}

.ph {
  color: #b3ab9c;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.miniopt {
  font-size: 24rpx;
  padding: 10rpx 18rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 10rpx;
  border: 1rpx solid #d8d0c0;
  background: #fffdf8;
  color: #6b6558;
}

.miniopt.on {
  border-color: #a6342a;
  background: #fdf6f3;
  color: #a6342a;
  font-weight: 600;
}

.s-row {
  margin-bottom: 16rpx;
}

.s-head {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.s-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #211f1c;
  margin-right: 10rpx;
}

.s-meta {
  display: block;
  font-size: 21rpx;
  color: #9c9587;
  margin-top: 8rpx;
}

.s-summary {
  display: block;
  font-size: 23rpx;
  line-height: 1.6;
  color: #6b6558;
  margin-top: 10rpx;
}

.s-open {
  display: block;
  font-size: 22rpx;
  color: #a6342a;
  margin-top: 12rpx;
}
