/* 作答沉淀与分析 · 视觉对齐 app.wxss：#a6342a / #f4f1ea / #fffdf8 */

.note {
  display: block;
  font-size: 22rpx;
  line-height: 1.75;
  color: #9c9587;
  margin-top: 14rpx;
}

/* 四档得分 */
.scorebox {
  padding: 28rpx;
}

.score-hd {
  display: flex;
  align-items: baseline;
  margin: 8rpx 0 20rpx;
}

.score-num {
  color: #a6342a;
  font-size: 68rpx;
}

.score-unit {
  font-size: 23rpx;
  color: #9c9587;
  margin-left: 16rpx;
}

.lv-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-top: 1rpx solid #eae4d7;
}

.lv-name {
  flex: 1;
  font-size: 25rpx;
  color: #4a453c;
}

.lv-pts {
  font-family: Georgia, serif;
  font-size: 24rpx;
  color: #a6342a;
  margin-right: 20rpx;
}

.lv-n {
  font-size: 22rpx;
  color: #9c9587;
  width: 90rpx;
  text-align: right;
}

/* 流水条目 */
.fitem {
  background: #fffdf8;
  border: 1rpx solid #e6dfd1;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
}

.f-hd,
.w-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.f-when,
.w-when {
  font-size: 21rpx;
  color: #9c9587;
}

.f-stem {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  color: #211f1c;
  margin-top: 12rpx;
}

.f-ft {
  margin-top: 10rpx;
}

.f-meta,
.w-meta {
  display: block;
  font-size: 21rpx;
  line-height: 1.6;
  color: #6b6558;
  margin-top: 8rpx;
}

.f-fam {
  display: block;
  font-size: 22rpx;
  color: #a6342a;
  margin-top: 8rpx;
}

.f-title {
  display: block;
  font-size: 21rpx;
  color: #9c9587;
  margin-top: 6rpx;
}

/* 错题条目 */
.witem {
  background: #fffdf8;
  border-left: 4rpx solid #a6342a;
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
}

/* 雷达 */
.radar-wrap {
  position: relative;
  width: 100%;
  height: 560rpx;
  margin: 8rpx 0 12rpx;
}

.radar-canvas {
  width: 100%;
  height: 560rpx;
  display: block;
}

.radar-label {
  position: absolute;
  transform: translate(-50%, -50%);
  text-align: center;
  width: 168rpx;
  pointer-events: none;
}

.radar-lname {
  display: block;
  font-size: 20rpx;
  color: #6b6558;
  line-height: 1.3;
}

.radar-lval {
  display: block;
  font-family: Georgia, serif;
  font-size: 24rpx;
  color: #a6342a;
}

.radar-fail {
  font-size: 22rpx;
  color: #a6342a;
  line-height: 1.7;
  margin: 12rpx 0;
}

/* 六维数值与口径 */
.abil-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.abil-name {
  width: 170rpx;
  flex: none;
  font-size: 23rpx;
  color: #4a453c;
}

.abil-bar {
  flex: 1;
  height: 10rpx;
  background: #efe9dc;
  border-radius: 5rpx;
  overflow: hidden;
  margin: 0 16rpx;
}

.abil-fill {
  height: 100%;
  background: #a6342a;
  border-radius: 5rpx;
}

.abil-val {
  width: 60rpx;
  flex: none;
  text-align: right;
  font-family: Georgia, serif;
  font-size: 24rpx;
  color: #a6342a;
}

.abil-desc {
  padding: 10rpx 0;
  border-top: 1rpx solid #eae4d7;
}

.abil-dname {
  display: block;
  font-size: 22rpx;
  line-height: 1.7;
  color: #6b6558;
}
