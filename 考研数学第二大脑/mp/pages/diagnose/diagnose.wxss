/* 知识卡三入口：tabBar 满 5 项，只能从这里 navigateTo */
.kbentry {
  margin-bottom: 32rpx;
}

/* 统计补充折叠块：覆盖度 / 错因 / 连续答错 */
.statbox {
  padding: 24rpx;
}

.stat-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stat-toggle .sec {
  margin: 0;
}

.stat-arrow {
  font-size: 22rpx;
  color: #a6342a;
}

.stat-sec {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eae4d7;
}

.stat-h {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
  color: #211f1c;
  margin-bottom: 10rpx;
}

.stat-p {
  display: block;
  font-size: 24rpx;
  line-height: 1.75;
  color: #4a453c;
}

.stat-gaps {
  display: block;
  font-size: 24rpx;
  line-height: 1.75;
  color: #a6342a;
  margin-top: 8rpx;
}

.stat-warn {
  display: block;
  font-size: 22rpx;
  line-height: 1.75;
  color: #9c9587;
  margin-top: 10rpx;
}

.err-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.err-name {
  width: 150rpx;
  font-size: 23rpx;
  color: #4a453c;
  flex: none;
}

.err-bar {
  flex: 1;
  margin: 0 16rpx;
}

.err-pct {
  width: 110rpx;
  text-align: right;
  font-size: 22rpx;
  color: #9c9587;
  flex: none;
}

.stat-item {
  display: block;
  font-size: 23rpx;
  line-height: 1.7;
  color: #a6342a;
  margin-bottom: 6rpx;
}

.kbbtns {
  display: flex;
}

.kbbtn {
  flex: 1;
  margin-right: 12rpx;
  padding: 18rpx 8rpx;
  font-size: 25rpx;
}

.kbbtn:last-child {
  margin-right: 0;
}

.summary {
  background: #211f1c;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 32rpx;
}

.sum-line {
  display: block;
  font-size: 27rpx;
  line-height: 1.8;
  color: #e8e2d5;
}

.sum-line + .sum-line {
  margin-top: 10rpx;
}

.sum-line.warn {
  color: #e8b4a8;
}

.sum-line .b {
  font-family: Georgia, serif;
  font-size: 32rpx;
  color: #fffdf8;
}

.sum-line.warn .b {
  color: #f0a596;
}

.note {
  display: block;
  font-size: 22rpx;
  line-height: 1.75;
  color: #9c9587;
  margin-top: 14rpx;
}

/* 优先级 */
.prio {
  background: #fffdf8;
  border: 1rpx solid #e6dfd1;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.prio-hd {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.prio-name {
  font-size: 29rpx;
  font-weight: 600;
  color: #211f1c;
  flex: 1;
  margin-right: 16rpx;
}

.prio-pct {
  font-family: Georgia, serif;
  font-size: 30rpx;
  color: #a6342a;
}

.bar {
  height: 8rpx;
  background: #efe9dc;
  border-radius: 4rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: #a6342a;
  border-radius: 4rpx;
}

.prio-meta {
  display: block;
  font-size: 21rpx;
  color: #9c9587;
  margin-top: 12rpx;
}

/* 卡点 */
.stuck-wrap {
  margin-bottom: 32rpx;
}

.stuck-item {
  border-left: 4rpx solid #a6342a;
  padding: 4rpx 0 4rpx 20rpx;
  margin-bottom: 20rpx;
}

.stuck-n {
  display: inline-block;
  font-size: 21rpx;
  color: #a6342a;
  font-family: Georgia, serif;
  margin-right: 12rpx;
}

.stuck-t {
  font-size: 26rpx;
  line-height: 1.65;
  color: #211f1c;
}

.stuck-meta {
  display: block;
  font-size: 21rpx;
  color: #9c9587;
  margin-top: 6rpx;
}

/* 记录 */
.rec {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eae4d7;
}

.rec-hd {
  display: flex;
  align-items: center;
}

.rec-thumb {
  width: 72rpx;
  height: 72rpx;
  border-radius: 10rpx;
  background: #eae4d7;
  flex: none;
  margin-right: 16rpx;
}

.rec-hd-main {
  flex: 1;
  min-width: 0;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.rec-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #211f1c;
}

.rec-when {
  font-size: 21rpx;
  color: #9c9587;
}

.rec-text {
  display: block;
  font-size: 23rpx;
  color: #6b6558;
  margin-top: 8rpx;
  line-height: 1.6;
}

.rec-ft {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.rec-del {
  font-size: 22rpx;
  color: #b3ab9c;
  padding: 6rpx 12rpx;
}
