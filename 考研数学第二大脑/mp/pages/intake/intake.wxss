/* ---------- 拍照入口 ---------- */
.shoot {
  padding-bottom: 22rpx;
}

/* 主按钮：整块可点，字号压过页面上所有正文 */
.snap {
  margin-top: 20rpx;
  padding: 36rpx 30rpx;
  border-radius: 16rpx;
  background: #211f1c;
  border: 1rpx solid #211f1c;
}

.snap-t {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #fffdf8;
  letter-spacing: 1rpx;
  line-height: 1.3;
}

.snap-h {
  display: block;
  font-size: 22rpx;
  color: #b9b2a3;
  margin-top: 8rpx;
  line-height: 1.4;
}

.snap:active {
  opacity: 0.85;
}

.snap.disabled {
  opacity: 0.45;
}

.srcs {
  display: flex;
  margin-top: 16rpx;
}

.src {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 14rpx;
  border: 1rpx solid #d8d0c0;
  background: #fffdf8;
}

.src-t {
  display: block;
  font-size: 27rpx;
  color: #4a453c;
  line-height: 1.4;
}

.src-h {
  display: block;
  font-size: 20rpx;
  color: #9c9587;
  margin-top: 2rpx;
  line-height: 1.4;
}

.src + .src {
  margin-left: 14rpx;
}

.src.disabled {
  opacity: 0.45;
}

.src:active {
  opacity: 0.8;
}

/* ---------- 已选图片 ---------- */
.shot {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #eae4d7;
}

.thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #eae4d7;
  flex: none;
}

.shot-body {
  flex: 1;
  min-width: 0;
  padding: 0 18rpx;
}

.shot-t {
  display: block;
  font-size: 27rpx;
  color: #211f1c;
  line-height: 1.5;
}

.shot-t.ok {
  color: #2f6b52;
  font-weight: 600;
}

.shot-t.loading {
  color: #a6342a;
}

.shot-h {
  display: block;
  font-size: 21rpx;
  color: #9c9587;
  margin-top: 4rpx;
  line-height: 1.5;
}

.shot-act {
  flex: none;
  font-size: 24rpx;
  color: #6b6558;
  padding: 12rpx 18rpx;
  border: 1rpx solid #d8d0c0;
  border-radius: 10rpx;
}

/* ---------- 命中真题 ---------- */
.orig {
  background: #f2f7f3;
  border-color: #cfe3d7;
}

.orig-top {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.orig-label {
  font-size: 24rpx;
  color: #2f6b52;
}

.orig-stem {
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 26rpx;
  line-height: 1.72;
  color: #211f1c;
}

.orig-btn {
  margin-top: 18rpx;
  padding: 18rpx;
  font-size: 26rpx;
}

.orig-done {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: 10rpx;
  background: #e2efe7;
}

.orig-done-t {
  font-size: 24rpx;
  color: #2f6b52;
}

/* ---------- 识别文本 ---------- */
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.ocr-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.75;
  color: #4a453c;
  white-space: pre-wrap;
  word-break: break-all;
}

.ocr-text.clamp {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.note.warn {
  color: #a6342a;
}

/* ---------- 粘贴（备用） ---------- */
.ta {
  width: 100%;
  height: 200rpx;
  font-size: 27rpx;
  line-height: 1.65;
  color: #211f1c;
  margin-top: 18rpx;
  margin-bottom: 22rpx;
  box-sizing: border-box;
}

.ph {
  color: #b3ab9c;
  font-size: 26rpx;
}

.note {
  display: block;
  font-size: 22rpx;
  line-height: 1.75;
  color: #9c9587;
  margin-top: 14rpx;
}

.link {
  font-size: 25rpx;
  color: #a6342a;
}

.sub-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sub-row .note {
  margin-top: 0;
}

/* 考点卡 */
.kp-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.kp-name {
  font-family: "Songti SC", "SimSun", Georgia, serif;
  font-size: 36rpx;
  font-weight: 600;
  color: #211f1c;
  flex: 1;
  margin-right: 16rpx;
}

.stats {
  display: flex;
  border-top: 1rpx solid #eae4d7;
  padding-top: 20rpx;
}

.st {
  flex: 1;
  text-align: center;
}

.st .num {
  display: block;
  color: #211f1c;
}

.st .lb {
  display: block;
  font-size: 21rpx;
  color: #9c9587;
  margin-top: 2rpx;
}

/* 判定卡 */
.verdict {
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #e6dfd1;
  background: #fffdf8;
}

.v-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
  font-family: "Songti SC", "SimSun", Georgia, serif;
}

.v-desc {
  display: block;
  font-size: 26rpx;
  line-height: 1.7;
  color: #4a453c;
}

.v-meta {
  margin-top: 16rpx;
}

.verdict.ok-hot {
  background: #f2f7f3;
  border-color: #cfe3d7;
}

.verdict.ok-hot .v-title {
  color: #2f6b52;
}

.verdict.ok-cold,
.verdict.ok-gone {
  background: #f2f5f8;
  border-color: #d7e0e9;
}

.verdict.ok-cold .v-title,
.verdict.ok-gone .v-title {
  color: #3d5a80;
}

.verdict.off-method,
.verdict.off {
  background: #fbf1ef;
  border-color: #eccfc9;
}

.verdict.off-method .v-title,
.verdict.off .v-title {
  color: #a6342a;
}

.verdict.nodata {
  background: #f6f4ee;
}

.verdict.nodata .v-title {
  color: #6b6558;
}

/* 保存后 */
.saved {
  background: #f2f7f3;
  border-color: #cfe3d7;
}

.saved-t {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #2f6b52;
  margin-bottom: 6rpx;
}

.saved-row {
  display: flex;
  margin-top: 24rpx;
}

.saved-row .half {
  flex: 1;
  padding: 20rpx;
  font-size: 26rpx;
}

.saved-row .half + .half {
  margin-left: 16rpx;
}

/* ---------- 刷题价值判定卡 ---------- */
/* 分带颜色沿用全站语义：红=真题级，绿=值得刷，赭=存疑，灰=跳过 */
.p-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 10rpx;
}

.p-title {
  font-size: 31rpx;
  font-weight: 600;
}

.p-sim {
  font-family: Georgia, serif;
  font-size: 24rpx;
  color: #9c9587;
}

.p-desc {
  display: block;
  font-size: 26rpx;
  line-height: 1.7;
  color: #4a453c;
}

.p-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.practice {
  border-left: 6rpx solid #d8d0c0;
}

.practice.p-exam {
  border-left-color: #a6342a;
}

.practice.p-exam .p-title {
  color: #a6342a;
}

.practice.p-worth {
  border-left-color: #2f6b52;
}

.practice.p-worth .p-title {
  color: #2f6b52;
}

.practice.p-edge {
  border-left-color: #b08329;
}

.practice.p-edge .p-title {
  color: #8a651f;
}

.practice.p-skip .p-title {
  color: #6b6558;
}
