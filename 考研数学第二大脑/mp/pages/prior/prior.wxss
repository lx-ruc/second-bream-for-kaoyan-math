.search {
  margin-bottom: 24rpx;
}

.inp {
  background: #fffdf8;
  border: 1rpx solid #e6dfd1;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  font-size: 27rpx;
}

.ph {
  color: #b3ab9c;
}

.thead {
  display: flex;
  padding: 0 4rpx 12rpx;
  border-bottom: 1rpx solid #d8d0c0;
}

.th {
  font-size: 21rpx;
  color: #9c9587;
  letter-spacing: 1rpx;
  width: 130rpx;
  text-align: right;
  flex: none;
}

.th.name {
  flex: 1;
  text-align: left;
  width: auto;
}

.tr {
  display: flex;
  align-items: center;
  padding: 20rpx 4rpx;
  border-bottom: 1rpx solid #f1ece1;
}

.td.name {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.tr-name {
  display: block;
  font-size: 26rpx;
  color: #211f1c;
  line-height: 1.45;
}

.tr-pt {
  display: block;
  font-size: 20rpx;
  color: #b3ab9c;
  margin-top: 3rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.td {
  width: 130rpx;
  text-align: right;
  flex: none;
  font-size: 23rpx;
  color: #6b6558;
}

.td.fr {
  font-family: Georgia, serif;
}

.td.fr.hot {
  color: #a6342a;
}

.td.tg {
  font-size: 21rpx;
  color: #9c9587;
}

.btn.ghost {
  margin-top: 28rpx;
}
